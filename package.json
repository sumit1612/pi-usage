{
  "name": "pi-usage-cli",
  "version": "1.1.2",
  "description": "Token, context, and cost usage dashboard for the pi coding agent — a themed CLI plus an interactive /usage command",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "usage",
    "tokens",
    "cost",
    "dashboard",
    "cli"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sumit1612/pi-usage.git"
  },
  "bin": {
    "pi-usage": "./bin/pi-usage"
  },
  "files": [
    "bin",
    "extensions",
    "lib",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "./docs/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
