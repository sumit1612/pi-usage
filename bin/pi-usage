#!/usr/bin/env node
'use strict';

const { aggregate, toData, DEFAULT_SESSION_DIR } = require('../lib/core.js');
const { renderDashboard } = require('../lib/presentation.js');
const VIEWS = ['overview', 'models', 'providers', 'agents', 'days', 'sessions'];
const SORTS = ['cost', 'tokens', 'calls', 'name'];
const GROUPS = ['day', 'week', 'month'];
const HELP = `pi-usage — local token and cost dashboard

  pi-usage [overview|models|providers|agents|days|sessions] [flags]

  --since N         last N days (default 30)
  --all             include all time
  --model TEXT      filter by model
  --provider TEXT   filter by provider
  --cwd PATH        filter by working directory
  --dir PATH        session directory
  --group GROUP     day | week | month
  --sort KEY        cost | tokens | calls | name
  --limit N         table rows (default 15)
  --json            JSON export
  --csv / --tsv     export the current view (overview exports models)
  --budget N        exit 3 when recorded cost exceeds $N
  --watch           refresh every 2 seconds
  --color           force color
  --plain           no color or decorative Unicode
  -h, --help        show help
`;

function parseArgs(argv) {
  const opts = { view: 'overview', since: 30, all: false, limit: 15, sort: 'cost', group: 'day',
    dir: process.env.PI_SESSION_DIR || DEFAULT_SESSION_DIR };
  const flags = new Set(['all', 'json', 'csv', 'tsv', 'watch', 'color', 'plain']);
  const values = new Set(['since', 'model', 'provider', 'cwd', 'dir', 'group', 'sort', 'limit', 'budget']);
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '-h' || arg === '--help') { console.log(HELP); process.exit(0); }
    if (VIEWS.includes(arg)) { opts.view = arg; continue; }
    const key = arg.startsWith('--') ? arg.slice(2) : '';
    if (flags.has(key)) { opts[key] = true; continue; }
    if (!values.has(key)) throw new Error(`Unknown argument: ${arg}`);
    const value = argv[++i];
    if (value === undefined || value.startsWith('--')) throw new Error(`Missing value for ${arg}`);
    if (['since', 'limit', 'budget'].includes(key)) {
      const n = Number(value);
      if (!value.trim() || !Number.isFinite(n) || n < 0 || (key !== 'budget' && !Number.isInteger(n)) || (key === 'limit' && n < 1)) {
        throw new Error(`Invalid ${arg} value: ${value}`);
      }
      opts[key] = n;
    } else opts[key] = value;
  }
  if (!SORTS.includes(opts.sort)) throw new Error(`Invalid --sort (expected ${SORTS.join(', ')})`);
  if (!GROUPS.includes(opts.group)) throw new Error(`Invalid --group (expected ${GROUPS.join(', ')})`);
  return opts;
}

function sortUsageEntries(entries, sort) {
  return entries.sort((a, b) => sort === 'name' ? a[0].localeCompare(b[0]) :
    sort === 'tokens' ? b[1].tokens.total - a[1].tokens.total : sort === 'calls' ? b[1].calls - a[1].calls : b[1].cost.total - a[1].cost.total);
}

function exportDelimited(agg, opts, delim) {
  const cell = value => {
    const s = String(value);
    if (delim === '\t') return s;
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  };
  const row = cells => cells.map(cell).join(delim);
  const usage = u => [u.calls, u.tokens.input, u.tokens.output, u.tokens.cacheRead, u.tokens.cacheWrite,
    u.tokens.reasoning, u.tokens.context, u.tokens.total, u.cost.total.toFixed(6),
    u.cacheHitRate.toFixed(4), u.reasoningRatio.toFixed(4), u.costPer1M.toFixed(4), Math.round(u.avgTokensPerCall)];
  const fields = ['calls', 'input', 'output', 'cache_read', 'cache_write', 'reasoning', 'context', 'total_tokens',
    'cost_total', 'cache_hit_rate', 'reasoning_ratio', 'cost_per_1M', 'avg_tokens_per_call'];
  let rows;
  if (opts.view === 'sessions') {
    rows = [['session', 'kind', 'cwd', ...fields], ...[...agg.bySession.values()]
      .sort((a, b) => b.usage.cost.total - a.usage.cost.total)
      .map(s => [s.name || s.file, s.kind, s.cwd || '', ...usage(s.usage)])];
  } else {
    const entries = opts.view === 'days' ? [...agg.byDay].sort() : sortUsageEntries(
      [...(opts.view === 'providers' ? agg.byProvider : opts.view === 'agents' ? agg.byAgent : agg.byModel)], opts.sort);
    rows = [[opts.view === 'days' ? 'date' : 'key', ...fields], ...entries.map(([k, u]) => [k, ...usage(u)])];
  }
  process.stdout.write(rows.map(row).join('\n') + '\n');
}

function main() {
  let opts;
  try { opts = parseArgs(process.argv.slice(2)); }
  catch (error) { console.error(error.message); process.exitCode = 2; return; }
  const noColor = !!process.env.NO_COLOR && process.env.NO_COLOR !== '0';
  const color = !opts.plain && !noColor && (process.stdout.isTTY || opts.color);
  const tick = () => {
    let agg;
    try { agg = aggregate(opts); }
    catch (error) { console.error(error.message); process.exitCode = 1; return; }
    if (opts.watch && process.stdout.isTTY) process.stdout.write('\x1b[2J\x1b[H');
    if (opts.budget != null && agg.totals.cost.total > opts.budget) {
      process.exitCode = 3;
      if (!opts.json && !opts.csv && !opts.tsv) console.error(`Budget exceeded: $${agg.totals.cost.total.toFixed(4)} > $${opts.budget}`);
    }
    if (opts.json) console.log(JSON.stringify(toData(agg), null, 2));
    else if (opts.csv || opts.tsv) exportDelimited(agg, opts, opts.tsv ? '\t' : ',');
    else console.log(renderDashboard(agg, opts, process.stdout.columns || 80, color));
  };
  tick();
  if (opts.watch) {
    const timer = setInterval(tick, 2000);
    process.on('SIGINT', () => { clearInterval(timer); process.exit(process.exitCode || 0); });
  }
}
main();
